{
  "name": "@introduction-graphql/schema-evolution",
  "version": "1.0.0",
  "description": "Evolve a schema additively, deprecate fields and detect breaking changes",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.ts",
    "start:solution": "node solution/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "schema:diff": "node src/schema-diff.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@graphql-inspector/core": "^8.0.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
