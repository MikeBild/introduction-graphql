{
  "name": "@introduction-graphql/schema-evolution",
  "version": "1.0.0",
  "description": "Evolve a schema additively on Apollo Server 5, deprecate fields, detect breaking changes and find clients that still use them",
  "private": true,
  "type": "module",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.ts",
    "start:solution": "node solution/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "schema:diff": "node src/schema-diff.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-inspector/core": "^8.0.1",
    "express": "^5.3.0",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
